<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#111827"
    android:padding="10dp"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvChNum"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:text="0001"
        android:textColor="#38BDF8"
        android:textSize="13sp"
        android:textStyle="bold"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="6dp">

        <TextView
            android:id="@+id/tvChIdent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FULL DVB CHANNEL IDENT"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="false"/>

        <TextView
            android:id="@+id/tvChMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Provider • 11680 H 27500 • DVB-S2 8PSK"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnCopyIdent"
        android:layout_width="48dp"
        android:layout_height="36dp"
        android:text="Copy"
        android:textSize="10sp"
        android:padding="0dp"
        android:backgroundTint="#1E293B"
        android:textColor="#38BDF8"/>

    <Button
        android:id="@+id/btnMoveUp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="▲"
        android:textSize="11sp"
        android:padding="0dp"
        android:backgroundTint="#1E293B"
        android:textColor="#FBBF24"
        android:layout_marginStart="4dp"/>

    <Button
        android:id="@+id/btnDeleteCh"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="✕"
        android:textSize="11sp"
        android:padding="0dp"
        android:backgroundTint="#3F1D24"
        android:textColor="#F87171"
        android:layout_marginStart="4dp"/>

</LinearLayout>
