<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com"
    xmlns:app="http://android.com"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0D0D0D" android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="DG Stream Pro - 4K / H.265 (ALI &amp; GX)" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <EditText android:id="@+id/ipInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:hint="Receiver IP (192.168.1.x)" android:textColor="#FFFFFF" android:textColorHint="#888888"
            android:background="#1E1E1E" android:padding="10dp" android:inputType="phone"/>
        <Button android:id="@+id/btnConnect" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="Connect" android:layout_marginStart="8dp" android:backgroundTint="#1E88E5"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/btnScan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp"
            android:text="Auto Scan (ALI / GX)" android:backgroundTint="#2E7D32"/>
        <Button android:id="@+id/btnExternalPlayer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp"
            android:text="Open in VLC / MX" android:layout_marginStart="8dp" android:backgroundTint="#E65100"/>
    </LinearLayout>
    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Tap channel to play | Long-press for VLC/MX" android:textColor="#00E676" android:paddingVertical="6dp"/>
    <androidx.media3.ui.PlayerView android:id="@+id/playerView" android:layout_width="match_parent"
        android:layout_height="220dp" android:background="#000000" android:keepScreenOn="true"
        app:resize_mode="fit" app:use_controller="true" android:layout_marginBottom="10dp"/>
    <ListView android:id="@+id/channelList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
