<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090D16"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="DG PLAY SCREEN"
            android:textColor="#38BDF8"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnScan"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Smart Scan"
            android:textSize="12sp"
            android:backgroundTint="#1E293B"
            android:textColor="#38BDF8"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/connectBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <EditText
            android:id="@+id/etIpAddress"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:hint="Receiver IP (e.g. 192.168.1.5)"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:background="#131926"
            android:paddingHorizontal="10dp"
            android:inputType="phone"/>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Connect"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Ready"
        android:textColor="#FBBF24"
        android:textSize="11sp"
        android:layout_marginBottom="6dp"/>
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="195dp"
        android:background="#000000"
        android:visibility="gone"
        android:layout_marginBottom="6dp">

        <org.videolan.libvlc.util.VLCVideoLayout
            android:id="@+id/vlcVideoLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="top|end"
            android:layout_margin="6dp">

            <Button
                android:id="@+id/btnFullscreen"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Full"
                android:textSize="11sp"
                android:backgroundTint="#990284C7"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnStopPlayer"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Close"
                android:textSize="11sp"
                android:backgroundTint="#99DC2626"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layoutInfoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#111827"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvInfoChannelName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="0001. CHANNEL IDENT"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="false"/>

            <TextView
                android:id="@+id/tvBadgeRes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HD"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:background="#1E293B"
                android:paddingHorizontal="6dp"
                android:layout_marginStart="4dp"/>

            <TextView
                android:id="@+id/tvBadgeCrypt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FTA"
                android:textColor="#FBBF24"
                android:textSize="10sp"
                android:background="#1E293B"
                android:paddingHorizontal="6dp"
                android:layout_marginHorizontal="4dp"/>

            <TextView
                android:id="@+id/tvInfoDb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14.2 dB"
                android:textColor="#4ADE80"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="#052E16"
                android:paddingHorizontal="8dp"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1F2937"
            android:layout_marginVertical="5dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvInfoSatFreq"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Nilesat • 11680 H 27500"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvInfoModulation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DVB-S2 • 8PSK • 3/4"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:background="#1E293B"
                android:paddingHorizontal="6dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvInfoBitrate"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Bitrate: 4.8 Mbps • 1080p HEVC"
                android:textColor="#94A3B8"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvInfoPids"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="V:512 A:650"
                android:textColor="#64748B"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:text="Signal (S):"
                android:textColor="#94A3B8"
                android:textSize="11sp"/>

            <ProgressBar
                android:id="@+id/pbStrength"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="8dp"
                android:max="100"
                android:progress="86"
                android:progressTint="#0EA5E9"/>

            <TextView
                android:id="@+id/tvStrengthVal"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="86%"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:gravity="end"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:text="Quality (Q):"
                android:textColor="#94A3B8"
                android:textSize="11sp"/>

            <ProgressBar
                android:id="@+id/pbQuality"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="8dp"
                android:max="100"
                android:progress="81"
                android:progressTint="#22C55E"/>

            <TextView
                android:id="@+id/tvQualityVal"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="81%"
                android:textColor="#4ADE80"
                android:textSize="11sp"
                android:gravity="end"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btnTabChannels"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:text="Channels"
            android:textSize="12sp"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnTabRemote"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:text="Remote"
            android:textSize="12sp"
            android:backgroundTint="#1E293B"
            android:textColor="#94A3B8"
            android:layout_marginHorizontal="6dp"/>

        <Button
            android:id="@+id/btnTabSatFinder"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:text="SatFinder"
            android:textSize="12sp"
            android:backgroundTint="#1E293B"
            android:textColor="#94A3B8"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutChannels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etSearchChannel"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="Search by full ident, provider or freq..."
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:background="#131926"
            android:paddingHorizontal="10dp"
            android:layout_marginBottom="6dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/layoutRemote"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <Button android:id="@+id/btnPower" android:layout_width="115dp" android:layout_height="46dp" android:text="POWER" android:backgroundTint="#DC2626"/>
                <Button android:id="@+id/btnMute" android:layout_width="115dp" android:layout_height="46dp" android:text="MUTE" android:backgroundTint="#1E293B" android:layout_marginStart="14dp"/>
            </LinearLayout>

            <Button android:id="@+id/btnUp" android:layout_width="100dp" android:layout_height="52dp" android:text="▲" android:textSize="18sp" android:backgroundTint="#1E293B" android:textColor="#38BDF8" android:layout_marginTop="10dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginVertical="4dp">
                <Button android:id="@+id/btnLeft" android:layout_width="90dp" android:layout_height="52dp" android:text="◄" android:textSize="18sp" android:backgroundTint="#1E293B" android:textColor="#38BDF8"/>
                <Button android:id="@+id/btnOk" android:layout_width="90dp" android:layout_height="52dp" android:text="OK" android:textStyle="bold" android:backgroundTint="#0284C7" android:layout_marginHorizontal="8dp"/>
                <Button android:id="@+id/btnRight" android:layout_width="90dp" android:layout_height="52dp" android:text="►" android:textSize="18sp" android:backgroundTint="#1E293B" android:textColor="#38BDF8"/>
            </LinearLayout>

            <Button android:id="@+id/btnDown" android:layout_width="100dp" android:layout_height="52dp" android:text="▼" android:textSize="18sp" android:backgroundTint="#1E293B" android:textColor="#38BDF8"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <Button android:id="@+id/btnMenu" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:text="MENU" android:backgroundTint="#1E293B"/>
                <Button android:id="@+id/btnInfo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:text="INFO" android:backgroundTint="#1E293B" android:layout_marginHorizontal="6dp"/>
                <Button android:id="@+id/btnExit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:text="EXIT" android:backgroundTint="#1E293B"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <Button android:id="@+id/btnVolUp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:text="VOL +" android:backgroundTint="#1E293B" android:textColor="#38BDF8"/>
                <Button android:id="@+id/btnVolDown" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:text="VOL -" android:backgroundTint="#1E293B" android:textColor="#38BDF8" android:layout_marginEnd="8dp"/>
                <Button android:id="@+id/btnChUp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:text="CH +" android:backgroundTint="#1E293B" android:textColor="#FBBF24"/>
                <Button android:id="@+id/btnChDown" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:text="CH -" android:backgroundTint="#1E293B" android:textColor="#FBBF24"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">
                <Button android:id="@+id/btnRed" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="" android:backgroundTint="#EF4444"/>
                <Button android:id="@+id/btnGreen" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="" android:backgroundTint="#22C55E" android:layout_marginHorizontal="6dp"/>
                <Button android:id="@+id/btnYellow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="" android:backgroundTint="#EAB308" android:layout_marginEnd="6dp"/>
                <Button android:id="@+id/btnBlue" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="" android:backgroundTint="#3B82F6"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/layoutSatFinder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#111827"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRO SATFINDER METER"
            android:textColor="#38BDF8"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvSatFinderFreq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select a channel to measure"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:id="@+id/tvSatFinderDb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0 dB"
            android:textColor="#4ADE80"
            android:textSize="46sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Signal Strength (S / AGC)"
            android:textColor="#38BDF8"
            android:textSize="12sp"/>

        <ProgressBar
            android:id="@+id/pbSatSignal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#0EA5E9"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Signal Quality (Q / SNR)"
            android:textColor="#4ADE80"
            android:textSize="12sp"/>

        <ProgressBar
            android:id="@+id/pbSatQuality"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#22C55E"
            android:layout_marginBottom="18dp"/>

        <Button
            android:id="@+id/btnToggleBeep"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Enable Audio Beep"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
