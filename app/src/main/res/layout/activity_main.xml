<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0F19"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="DG Play Screen"
            android:textColor="#38BDF8"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRO DVB-S2X"
            android:textColor="#22C55E"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#131926"
            android:padding="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/connectBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <EditText
            android:id="@+id/etIpAddress"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:hint="Receiver IP (192.168.1.x)"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:background="#131926"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:inputType="phone"/>

        <Button
            android:id="@+id/btnScan"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Scan"
            android:background="#1E293B"
            android:textColor="#38BDF8"
            android:layout_marginLeft="4dp"/>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Connect"
            android:background="#0284C7"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="4dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Ready (Condor/Android 6-15)"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>

    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:background="#000000"
        android:visibility="gone"
        android:layout_marginBottom="6dp">

        <FrameLayout
            android:id="@+id/vlcVideoLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/btnFullscreen"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="⛶"
                android:background="#80000000"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnStopPlayer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="✕"
                android:background="#CCDC2626"
                android:textColor="#FFFFFF"
                android:layout_marginLeft="4dp"/>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layoutInfoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#111827"
        android:padding="8dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvInfoChannelName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="0001. Channel"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/tvBadgeRes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HD"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:background="#1E293B"
                android:padding="3dp"
                android:layout_marginLeft="4dp"/>

            <TextView
                android:id="@+id/tvBadgeCrypt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FTA"
                android:textColor="#4ADE80"
                android:textSize="10sp"
                android:background="#1E293B"
                android:padding="3dp"
                android:layout_marginLeft="4dp"/>

            <TextView
                android:id="@+id/tvInfoDb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14.2 dB"
                android:textColor="#4ADE80"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginLeft="6dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvInfoSatFreq"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Nilesat • 11680 H 27500"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvInfoModulation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DVB-S2 • 8PSK • 3/4"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:background="#1E293B"
                android:padding="3dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvInfoBitrate"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Bitrate: 4.8 Mbps • 1080p"
                android:textColor="#94A3B8"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvInfoPids"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="V:512 A:650"
                android:textColor="#64748B"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">

            <TextView
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:text="Signal (S):"
                android:textColor="#94A3B8"
                android:textSize="11sp"/>

            <ProgressBar
                android:id="@+id/pbStrength"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="8dp"
                android:max="100"
                android:progress="86"/>

            <TextView
                android:id="@+id/tvStrengthVal"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="86%"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:gravity="end"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:text="Quality (Q):"
                android:textColor="#94A3B8"
                android:textSize="11sp"/>

            <ProgressBar
                android:id="@+id/pbQuality"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="8dp"
                android:max="100"
                android:progress="81"/>

            <TextView
                android:id="@+id/tvQualityVal"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="81%"
                android:textColor="#4ADE80"
                android:textSize="11sp"
                android:gravity="end"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btnTabChannels"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:text="Channels"
            android:textSize="12sp"
            android:background="#0284C7"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnTabRemote"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:text="Remote"
            android:textSize="12sp"
            android:background="#1E293B"
            android:textColor="#94A3B8"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"/>

        <Button
            android:id="@+id/btnTabSatFinder"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:text="SatFinder"
            android:textSize="12sp"
            android:background="#1E293B"
            android:textColor="#94A3B8"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutChannels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etSearchChannel"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:hint="Search channel / frequency..."
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:background="#131926"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    
        <ScrollView
        android:id="@+id/layoutRemote"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:background="#0F172A"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <Button android:id="@+id/btnPower" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="⏻ POWER" android:textSize="11sp" android:textStyle="bold" android:background="#DC2626" android:textColor="#FFFFFF"/>
                <Button android:id="@+id/btnMute" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="🔇 MUTE" android:textSize="11sp" android:background="#1E293B" android:textColor="#F8FAFC" android:layout_marginLeft="4dp"/>
                <Button android:id="@+id/btnTvRadio" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="TV / R" android:textSize="11sp" android:background="#1E293B" android:textColor="#38BDF8" android:layout_marginLeft="4dp"/>
                <Button android:id="@+id/btnRecall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="↺ BACK" android:textSize="11sp" android:background="#1E293B" android:textColor="#FBBF24" android:layout_marginLeft="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <Button android:id="@+id/btnSat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="SAT" android:textSize="11sp" android:textStyle="bold" android:background="#1E293B" android:textColor="#38BDF8"/>
                <Button android:id="@+id/btnFav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="★ FAV" android:textSize="11sp" android:background="#1E293B" android:textColor="#F472B6" android:layout_marginLeft="4dp"/>
                <Button android:id="@+id/btnEpg" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="EPG" android:textSize="11sp" android:background="#1E293B" android:textColor="#4ADE80" android:layout_marginLeft="4dp"/>
                <Button android:id="@+id/btnFind" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="🔍 FIND" android:textSize="11sp" android:background="#1E293B" android:textColor="#E2E8F0" android:layout_marginLeft="4dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                <Button android:id="@+id/btnNum1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="1" android:textSize="15sp" android:textStyle="bold" android:background="#1E293B" android:textColor="#FFFFFF"/>
                <Button android:id="@+id/btnNum2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="2" android:textSize="15sp" android:textStyle="bold" android:background="#1E293B" android:textColor="#FFFFFF" android:layout_marginLeft="4dp"/>
                <Button android:id="@+id/btnNum3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="3" android:textSize="15sp" android:textStyle="bold" android:background="#1E293B" android:textColor="#FFFFFF" android:layout_marginLeft="4dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                <Button android:id="@+id/btnNum4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="4" android:textSize="15sp" android:textStyle="bold" android:background="#1E293B" android:textColor="#FFFFFF"/>
                <Button android:id="@+id/btnNum5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="5" android:textSize="15sp" android:textStyle="bold" android:background="#1E293B" android:textColor="#FFFFFF" android:layout_marginLeft="4dp"/>
                <Button android:id="@+id/btnNum6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="6" android:textSize="15sp" android:textStyle="bold" android:background="#1E293B" android:textColor="#FFFFFF" android:layout_marginLeft="4dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                <Button android:id="@+id/btnNum7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="7" android:textSize="15sp" android:textStyle="bold" android:background="#1E293B" android:textColor="#FFFFFF"/>
                <Button android:id="@+id/btnNum8" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="8" android:textSize="15sp" android:textStyle="bold" android:background="#1E293B" android:textColor="#FFFFFF" android:layout_marginLeft="4dp"/>
                <Button android:id="@+id/btnNum9" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="9" android:textSize="15sp" android:textStyle="bold" android:background="#1E293B" android:textColor="#FFFFFF" android:layout_marginLeft="4dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                <Button android:id="@+id/btnAudio" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="AUDIO" android:textSize="11sp" android:background="#1E293B" android:textColor="#94A3B8"/>
                <Button android:id="@+id/btnNum0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="0" android:textSize="15sp" android:textStyle="bold" android:background="#1E293B" android:textColor="#FFFFFF" android:layout_marginLeft="4dp"/>
                <Button android:id="@+id/btnSub" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp" android:text="SUB" android:textSize="11sp" android:background="#1E293B" android:textColor="#94A3B8" android:layout_marginLeft="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <Button android:id="@+id/btnMenu" android:layout_width="match_parent" android:layout_height="48dp" android:text="MENU" android:textSize="12sp" android:textStyle="bold" android:background="#0284C7" android:textColor="#FFFFFF"/>
                    <Button android:id="@+id/btnExit" android:layout_width="match_parent" android:layout_height="48dp" android:text="EXIT" android:textSize="12sp" android:textStyle="bold" android:background="#334155" android:textColor="#F8FAFC" android:layout_marginTop="10dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp">

                    <Button android:id="@+id/btnUp" android:layout_width="64dp" android:layout_height="44dp" android:text="▲" android:textSize="16sp" android:background="#1E293B" android:textColor="#38BDF8"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp">
                        <Button android:id="@+id/btnLeft" android:layout_width="56dp" android:layout_height="52dp" android:text="◀" android:textSize="16sp" android:background="#1E293B" android:textColor="#38BDF8"/>
                        <Button android:id="@+id/btnOk" android:layout_width="64dp" android:layout_height="52dp" android:text="OK" android:textSize="14sp" android:textStyle="bold" android:background="#0284C7" android:textColor="#FFFFFF" android:layout_marginLeft="4dp" android:layout_marginRight="4dp"/>
                        <Button android:id="@+id/btnRight" android:layout_width="56dp" android:layout_height="52dp" android:text="▶" android:textSize="16sp" android:background="#1E293B" android:textColor="#38BDF8"/>
                    </LinearLayout>

                    <Button android:id="@+id/btnDown" android:layout_width="64dp" android:layout_height="44dp" android:text="▼" android:textSize="16sp" android:background="#1E293B" android:textColor="#38BDF8"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <Button android:id="@+id/btnInfo" android:layout_width="match_parent" android:layout_height="48dp" android:text="INFO" android:textSize="12sp" android:textStyle="bold" android:background="#1E293B" android:textColor="#38BDF8"/>
                    <Button android:id="@+id/btnPage" android:layout_width="match_parent" android:layout_height="48dp" android:text="LIST" android:textSize="12sp" android:textStyle="bold" android:background="#1E293B" android:textColor="#4ADE80" android:layout_marginTop="10dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <Button android:id="@+id/btnVolUp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:text="VOL +" android:textStyle="bold" android:background="#1E293B" android:textColor="#FFFFFF"/>
                <Button android:id="@+id/btnVolDown" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:text="VOL -" android:textStyle="bold" android:background="#1E293B" android:textColor="#FFFFFF" android:layout_marginLeft="4dp"/>
                <Button android:id="@+id/btnChUp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:text="CH ▲" android:textStyle="bold" android:background="#1E293B" android:textColor="#38BDF8" android:layout_marginLeft="10dp"/>
                <Button android:id="@+id/btnChDown" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:text="CH ▼" android:textStyle="bold" android:background="#1E293B" android:textColor="#38BDF8" android:layout_marginLeft="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <Button android:id="@+id/btnRed" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="F1" android:textSize="11sp" android:background="#DC2626" android:textColor="#FFFFFF"/>
                <Button android:id="@+id/btnGreen" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="F2" android:textSize="11sp" android:background="#16A34A" android:textColor="#FFFFFF" android:layout_marginLeft="4dp"/>
                <Button android:id="@+id/btnYellow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="F3" android:textSize="11sp" android:background="#CA8A04" android:textColor="#FFFFFF" android:layout_marginLeft="4dp"/>
                <Button android:id="@+id/btnBlue" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="F4" android:textSize="11sp" android:background="#2563EB" android:textColor="#FFFFFF" android:layout_marginLeft="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnRew" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:text="◀◀" android:textSize="11sp" android:background="#1E293B" android:textColor="#94A3B8"/>
                <Button android:id="@+id/btnPlayPause" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:text="▶❚❚" android:textSize="11sp" android:background="#1E293B" android:textColor="#94A3B8" android:layout_marginLeft="4dp"/>
                <Button android:id="@+id/btnStopMedia" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:text="■" android:textSize="11sp" android:background="#1E293B" android:textColor="#94A3B8" android:layout_marginLeft="4dp"/>
                <Button android:id="@+id/btnFwd" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:text="▶▶" android:textSize="11sp" android:background="#1E293B" android:textColor="#94A3B8" android:layout_marginLeft="4dp"/>
                <Button android:id="@+id/btnRec" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:text="● REC" android:textSize="10sp" android:background="#7F1D1D" android:textColor="#FCA5A5" android:layout_marginLeft="4dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>


        <LinearLayout
        android:id="@+id/layoutSatFinder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#131926"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE SATELLITE FINDER PRO"
            android:textColor="#38BDF8"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <!-- Active Satellite & Transponder Info Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0F172A"
            android:padding="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvSatFinderSatName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Satellite: Detecting..."
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvSatFinderFreq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transponder: Waiting for tuner data..."
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- SNR dB Big Display -->
        <TextView
            android:id="@+id/tvSatFinderDb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0.0 dB"
            android:textColor="#4ADE80"
            android:textSize="38sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="14dp"/>

        <!-- Signal Strength Row (RED Bar + Percentage) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="SIGNAL STRENGTH (S)"
                android:textColor="#FCA5A5"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvSatStrengthVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#EF4444"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbSatSignal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#EF4444"
            android:progressBackgroundTint="#334155"
            android:layout_marginBottom="14dp"/>

        <!-- Signal Quality Row (GREEN Bar + Percentage) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="SIGNAL QUALITY (Q)"
                android:textColor="#86EFAC"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvSatQualityVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#22C55E"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbSatQuality"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#22C55E"
            android:progressBackgroundTint="#334155"
            android:layout_marginBottom="18dp"/>

        <Button
            android:id="@+id/btnToggleBeep"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Enable Audio Beep"
            android:background="#0284C7"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
