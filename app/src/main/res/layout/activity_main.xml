<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1E293B"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etIpPort"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="192.168.1.x:20000"
            android:textColor="#F8FAFC"
            android:textColorHint="#94A3B8"
            android:textSize="13sp"
            android:singleLine="true"
            android:background="#0F172A"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:text="SCAN"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#0284C7" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:text="CONNECT"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#16A34A" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="Disconnected - Press SCAN or enter STB IP"
        android:textColor="#38BDF8"
        android:textSize="11sp"
        android:background="#0B1120" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:background="#1E293B">

        <Button
            android:id="@+id/tabChannels"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="CHAÎNES"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#0284C7" />

        <Button
            android:id="@+id/tabRemote"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="REMOTE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#1E293B" />

        <Button
            android:id="@+id/tabSatfinder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="SATFINDER"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#1E293B" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/layoutChannelsTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:padding="4dp"
            android:background="#1E293B"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnTvRadioToggle"
                android:layout_width="68dp"
                android:layout_height="36dp"
                android:text="TV"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#0284C7" />

            <Button
                android:id="@+id/btnSatDropdown"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Toutes les chaînes ▾"
                android:textSize="12sp"
                android:textColor="#F8FAFC"
                android:background="#334155"
                android:textAllCaps="false"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <EditText
            android:id="@+id/etSearchChannel"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_margin="6dp"
            android:hint="Rechercher une chaîne ou numéro..."
            android:textColor="#F8FAFC"
            android:textColorHint="#94A3B8"
            android:textSize="13sp"
            android:singleLine="true"
            android:background="#1E293B"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <ListView
            android:id="@+id/lvChannels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#0F172A"
            android:dividerHeight="1dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/layoutRemoteTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPower"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="POWER"
                    android:textColor="#FFFFFF"
                    android:background="#DC2626" />

                <Button
                    android:id="@+id/btnMute"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="MUTE"
                    android:textColor="#FFFFFF"
                    android:background="#475569" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btnMenu"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="MENU"
                    android:textColor="#FFFFFF"
                    android:background="#334155" />

                <Button
                    android:id="@+id/btnInfo"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="INFO"
                    android:textColor="#FFFFFF"
                    android:background="#334155" />

                <Button
                    android:id="@+id/btnExit"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="EXIT"
                    android:textColor="#FFFFFF"
                    android:background="#334155" />
            </LinearLayout>

            <Button
                android:id="@+id/btnUp"
                android:layout_width="84dp"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="▲"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="#1E293B" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnLeft"
                    android:layout_width="84dp"
                    android:layout_height="52dp"
                    android:layout_margin="4dp"
                    android:text="◀"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:background="#1E293B" />

                <Button
                    android:id="@+id/btnOk"
                    android:layout_width="84dp"
                    android:layout_height="52dp"
                    android:layout_margin="4dp"
                    android:text="OK"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#0284C7" />

                <Button
                    android:id="@+id/btnRight"
                    android:layout_width="84dp"
                    android:layout_height="52dp"
                    android:layout_margin="4dp"
                    android:text="▶"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:background="#1E293B" />
            </LinearLayout>
            <Button
                android:id="@+id/btnDown"
                android:layout_width="84dp"
                android:layout_height="52dp"
                android:text="▼"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="#1E293B" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <Button
                    android:id="@+id/btnVolUp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="VOL +"
                    android:textColor="#FFFFFF"
                    android:background="#334155" />

                <Button
                    android:id="@+id/btnChUp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="CH +"
                    android:textColor="#FFFFFF"
                    android:background="#334155" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnVolDown"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="VOL -"
                    android:textColor="#FFFFFF"
                    android:background="#334155" />

                <Button
                    android:id="@+id/btnChDown"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="CH -"
                    android:textColor="#FFFFFF"
                    android:background="#334155" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btnAudio"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="AUDIO"
                    android:textColor="#FFFFFF"
                    android:background="#475569" />

                <Button
                    android:id="@+id/btnFavRemote"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="FAV"
                    android:textColor="#FACC15"
                    android:background="#475569" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutSatfinderTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvSatSignalInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Signal Meter (Live)"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Signal Strength"
                android:textColor="#CBD5E1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvStrengthPct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#EF4444"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbStrength"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:max="100"
            android:progress="0"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Signal Quality"
                android:textColor="#CBD5E1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvQualityPct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#22C55E"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbQuality"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:max="100"
            android:progress="0"
            android:layout_marginTop="6dp" />
    </LinearLayout>

</LinearLayout>
